{
  "name": "ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // The frame's memory: every exchange plus Claude's long-term notes.
  "durable_objects": {
    "bindings": [{ "name": "MEMORY", "class_name": "Memory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Memory"] }],
  // Lets the frame tell when a new version has finished deploying.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Only ai.liljimjim.com (behind Cloudflare Access) should serve the frame.
  // Keep the workers.dev address and preview URLs switched off on every deploy.
  "workers_dev": false,
  "preview_urls": false
  // Secrets ANTHROPIC_API_KEY and ELEVENLABS_API_KEY are set in the
  // Cloudflare dashboard, never in this file.
}
